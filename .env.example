# =====================================================================
# XTT — plantilla de entorno
# Copia a `.env.local` y rellena. Ninguna de estas variables tiene valor
# por defecto en producción: si falta una, el arranque lo dice.
# =====================================================================

# --- Sitio ---
# URL pública canónica. Alimenta `metadataBase`, los canonicals, el sitemap y
# el JSON-LD. Sin protocolo correcto, las OG images salen con rutas relativas
# y ninguna red social las resuelve.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# Despliegue (solo en el VPS, no en local)
# =====================================================================

# Qué entorno es este. Docker Compose lee `COMPOSE_FILE` de este mismo .env,
# así que es esta línea —y no el comando— la que decide si el servidor sirve la
# previsualización o producción. Por eso el despliegue automático puede ser el
# mismo en los dos casos: el workflow siempre corre `docker compose up`, y el
# entorno lo define el servidor.
#
# Cambiar de previsualización a producción es borrar el override de esta línea
# y reconstruir (ver el aviso de NEXT_PUBLIC_SITE_URL más abajo).
# COMPOSE_FILE=docker-compose.yml:docker-compose.preview.yml
# COMPOSE_FILE=docker-compose.yml

# Dominio que sirve Caddy. Se usa para pedir el certificado TLS.
#
# En PREVISUALIZACIÓN va el hostname gratis del VPS de Hostinger, que resuelve
# solo: Caddy saca el certificado sin tocar el DNS de xtt.com.mx y sin comprar
# ningún dominio. En PRODUCCIÓN, el dominio real.
# SITE_DOMAIN=srv123456.hstgr.cloud
# SITE_DOMAIN=xtt.com.mx

# Tiene que ir en pareja con NEXT_PUBLIC_SITE_URL, y esa se incrusta en el
# BUNDLE durante el build — no se lee al arrancar. Cambiar de entorno obliga a
# reconstruir la imagen, no basta con reiniciar el contenedor. Si se deja
# vacía, `src/config/brand.ts` cae a https://xtt.com.mx y la previsualización
# anunciaría canonicals de producción.

# --- Solo para el entorno de previsualización ---
# Los lee `Caddyfile.preview`, que se monta con:
#   docker compose -f docker-compose.yml -f docker-compose.preview.yml up -d --build
#
# El hash se genera así; la contraseña en claro NO se guarda en ningún archivo:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'la-que-sea'
# PREVIEW_USER=xtt
# PREVIEW_PASSWORD_HASH=

# --- La misma puerta, cuando no hay Caddy delante ---
# Las lee `src/proxy.ts`. Hacen falta en cualquier hosting que sirva la
# aplicación directamente —Vercel, por ejemplo, cuyo plan gratuito no ofrece
# contraseña—: ahí no hay nada entre internet y Next.
#
# Van en PLANO y no como hash, al contrario que la de Caddy: el proxy corre en
# el runtime edge, que no puede verificar un hash de bcrypt. No es la misma
# contraseña que la de arriba y no debe reutilizarse.
#
# La puerta se monta sola si están las DOS. En producción no se definen y el
# sitio queda abierto: no hay bandera que acordarse de apagar.
# `e2e/preview-gate.spec.ts` falla si alguien abre la puerta sin querer.
# PREVIEW_USER=xtt
# PREVIEW_PASSWORD=

# =====================================================================
# Formulario de contacto — webhook de n8n
# ---------------------------------------------------------------------
# El navegador NUNCA llama a n8n directamente: postea a /api/contact, que
# valida y reenvía. Así el webhook no se publica en el HTML y no hay CORS.
# =====================================================================

# URL de producción del webhook del workflow "XTT — Contacto sitio web".
# n8n → el workflow → nodo Webhook → pestaña "Production URL".
N8N_CONTACT_WEBHOOK_URL=

# Secreto compartido. Viaja en el header X-XTT-Signature y el nodo IF del
# workflow lo compara; sin él, cualquiera que descubra la URL puede inyectar
# correos. Genera uno con: openssl rand -hex 32
#
# No uses la autenticación por credencial "Header Auth" del nodo Webhook:
# en esta instancia guarda el valor en blanco (__n8n_BLANK_VALUE_…) y el
# webhook rechaza todo. Tampoco actives "Ignore Bots": descarta al fetch
# del servidor y responde con un engañoso "Authorization data is wrong!".
N8N_WEBHOOK_SECRET=

# =====================================================================
# Asistente de chat — webhook de n8n
# ---------------------------------------------------------------------
# Mismo esquema que el formulario: el navegador postea a /api/chat, que
# valida, limita, arma el contexto del sitio y reenvía firmado. Comparte
# el N8N_WEBHOOK_SECRET de arriba.
# =====================================================================

# Monta el widget en el sitio. Es NEXT_PUBLIC_ porque el layout se
# prerenderiza en build: una variable de runtime se leería como ausente
# al generar el HTML y el chat no llegaría a la página.
#
# Enciende también la sección del chat en el aviso de privacidad. Las dos
# mitades van juntas a propósito: no debe existir un chat que guarde
# conversaciones sin que el aviso lo declare.
NEXT_PUBLIC_CHAT_ENABLED=false

# URL de producción del webhook del workflow "XTT - Chat del sitio".
# Sin esto, /api/chat responde 503 y el widget lo dice; nunca inventa
# una respuesta.
N8N_CHAT_WEBHOOK_URL=
