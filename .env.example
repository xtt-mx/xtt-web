# =====================================================================
# XTT — plantilla de entorno
# Copia a `.env.local` y rellena. Ninguna de estas variables tiene valor
# por defecto en producción: si falta una, el arranque lo dice.
# =====================================================================

# --- Sitio ---
# URL pública canónica. Alimenta `metadataBase`, los canonicals, el sitemap y
# el JSON-LD. Sin protocolo correcto, las OG images salen con rutas relativas
# y ninguna red social las resuelve.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# Despliegue (solo en el VPS, no en local)
# =====================================================================

# Dominio que sirve Caddy. Se usa para pedir el certificado TLS.
# SITE_DOMAIN=xtt.com.mx

# =====================================================================
# Formulario de contacto — webhook de n8n
# ---------------------------------------------------------------------
# El navegador NUNCA llama a n8n directamente: postea a /api/contact, que
# valida y reenvía. Así el webhook no se publica en el HTML y no hay CORS.
# =====================================================================

# URL de producción del webhook del workflow "XTT — Contacto sitio web".
# n8n → el workflow → nodo Webhook → pestaña "Production URL".
N8N_CONTACT_WEBHOOK_URL=

# Secreto compartido. Viaja en el header X-XTT-Signature y el nodo IF del
# workflow lo compara; sin él, cualquiera que descubra la URL puede inyectar
# correos. Genera uno con: openssl rand -hex 32
#
# No uses la autenticación por credencial "Header Auth" del nodo Webhook:
# en esta instancia guarda el valor en blanco (__n8n_BLANK_VALUE_…) y el
# webhook rechaza todo. Tampoco actives "Ignore Bots": descarta al fetch
# del servidor y responde con un engañoso "Authorization data is wrong!".
N8N_WEBHOOK_SECRET=
